import numpy as np
import random
import matplotlib.pyplot as plt

ROWS = 4
COLS = 4
START = (0, 0)
GOAL = (3, 3)
OBSTACLE = (1, 1)
ACTIONS = [0, 1, 2, 3]

Q = np.zeros((ROWS, COLS, 4))

alpha = 0.1
gamma = 0.9
epsilon = 1.0
epsilon_min = 0.01
epsilon_decay = 0.995
episodes = 1000

rewards_history = []


def step(state, action):
    r, c = state

    if action == 0:
        r -= 1
    elif action == 1:
        r += 1
    elif action == 2:
        c -= 1
    elif action == 3:
        c += 1

    if r < 0 or r >= ROWS or c < 0 or c >= COLS:
        return state, -5, False

    if (r, c) == OBSTACLE:
        return state, -10, False

    if (r, c) == GOAL:
        return (r, c), 10, True

    return (r, c), -1, False


for episode in range(episodes):
    state = START
    total_reward = 0

    for step_count in range(100):
        if random.random() < epsilon:
            action = random.choice(ACTIONS)
        else:
            action = np.argmax(Q[state[0], state[1]])

        next_state, reward, done = step(state, action)

        old_value = Q[state[0], state[1], action]
        next_max = np.max(Q[next_state[0], next_state[1]])

        Q[state[0], state[1], action] = old_value + alpha * (
            reward + gamma * next_max - old_value
        )

        state = next_state
        total_reward += reward

        if done:
            break

    epsilon = max(epsilon_min, epsilon * epsilon_decay)
    rewards_history.append(total_reward)

print("Q-Table:")
print(Q)

print("\nOptimal Policy:")
symbols = ["↑", "↓", "←", "→"]

for r in range(ROWS):
    row = []
    for c in range(COLS):
        if (r, c) == START:
            row.append("S")
        elif (r, c) == GOAL:
            row.append("G")
        elif (r, c) == OBSTACLE:
            row.append("X")
        else:
            best_action = np.argmax(Q[r, c])
            row.append(symbols[best_action])
    print(row)

plt.plot(rewards_history)
plt.xlabel("Episode")
plt.ylabel("Total Reward")
plt.title("Q-Learning Performance")
plt.show()

epsilons = [max(epsilon_min, epsilon_decay ** i) for i in range(episodes)]

plt.plot(epsilons, label="Exploration (epsilon)")
plt.plot([1 - e for e in epsilons], label="Exploitation (1 - epsilon)")
plt.xlabel("Episode")
plt.ylabel("Probability")
plt.title("Exploration vs Exploitation")
plt.legend()
plt.show()
